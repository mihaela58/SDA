struct ListNode* reverseList(struct ListNode* head) {
    struct ListNode* anterior = NULL;
    struct ListNode* curent = head;
    struct ListNode* urmator;

    while (curent != NULL) {
        urmator = curent->next;
        curent->next = anterior;
        anterior = curent;
        curent = urmator;
    }

    return anterior;
}