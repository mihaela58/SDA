#include <stdbool.h>

bool isValid(char* s) {
    char stiva[10001];
    int top = -1;

    for (int i = 0; s[i] != '\0'; i++) {
        char ch = s[i];

        if (ch == '(' || ch == '[' || ch == '{') {
            stiva[++top] = ch;
        } else {
            if (top < 0)
                return false;

            char ultim = stiva[top--];

            if ((ch == ')' && ultim != '(') ||
                (ch == ']' && ultim != '[') ||
                (ch == '}' && ultim != '{')) {
                return false;
            }
        }
    }

    return top == -1;
}